---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  navInfo?: string;
  navContact?: string;
  locale?: string;
}

const {
  navInfo = "Info",
  navContact = "Contact",
  locale = "es",
} = Astro.props;
---

<header class="header">
  <nav class="nav">
    <button type="button" class="nav-link nav-btn" data-open-modal>{navInfo}</button>
    <button type="button" class="nav-link nav-btn" data-open-modal>{navContact}</button>
  </nav>

<script>
  document.querySelectorAll('[data-open-modal]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-portfolio-modal'));
      (window as any).openPortfolioModal?.();
    });
  });
</script>
  <LanguageSwitcher currentLocale={locale} />
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 3rem;
    background: linear-gradient(180deg, rgba(26, 26, 26, 0.95) 0%, rgba(26, 26, 26, 0) 100%);
    backdrop-filter: blur(8px);
    transition: background 0.3s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav {
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-gold);
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: var(--color-gold);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }

  @media (max-width: 768px) {
    .header {
      padding: 1rem 1.5rem;
    }

    .nav {
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .header {
      padding: 0.8rem 0.8rem;
    }

    .nav {
      gap: 0.8rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }
  }
</style>
