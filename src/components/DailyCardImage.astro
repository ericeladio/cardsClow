---
import CardOfTheDayIsland from './islands/CardOfTheDayIsland';
import type { Locale } from '../data/clowCards';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
---

<div class="card-display">
  <div class="card-wrapper">
    <div class="card-image">
      <CardOfTheDayIsland locale={locale} mode="image" client:load />
      <!-- Golden border glow -->
      <div class="card-glow"></div>
    </div>
    <CardOfTheDayIsland locale={locale} mode="image-label" client:load />
  </div>
</div>

<style>
  .card-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 1rem 0.5rem;
    position: relative;
    animation: fadeInLeft 0.8s ease-out 0.4s both;
    overflow: visible;
    width: 100%;
    height: 100%;
  }

  .card-wrapper {
    position: relative;
    z-index: 2;
    width: 240px;
    perspective: 1000px;
    transform: translateY(-50px);
  }

  .card-image {
    width: 100%;
    border-radius: 12px;
    overflow: visible;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(212, 168, 83, 0.15),
      0 0 80px rgba(212, 168, 83, 0.08);
    position: relative;
    transition: transform 0.5s ease, box-shadow 0.5s ease;
    transform: rotate(-3deg);
  }

  .card-image :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    display: block;
  }

  .card-image:hover {
    transform: rotate(0deg) translateY(-8px);
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.7),
      0 0 50px rgba(212, 168, 83, 0.2),
      0 0 100px rgba(212, 168, 83, 0.1);
  }

  Golden border glow overlay
  .card-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border: 2px solid rgba(212, 168, 83, 0.4);
    border-radius: 14px;
    pointer-events: none;
    animation: borderGlow 3s ease-in-out infinite;
  }

  :global(.card-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    z-index: 2;
    position: relative;
  }

  :global(.label-star) {
    width: 10px;
    height: 10px;
    animation: twinkle 3s ease-in-out infinite;
  }

  :global(.label-star:last-child) {
    animation-delay: 1.5s;
  }

  :global(.card-name) {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-gold);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-shadow: 0 0 10px rgba(212, 168, 83, 0.3);
  }

  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  @keyframes borderGlow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
  }

  @media (max-width: 1200px) {
    .card-display {
      padding: 0.8rem 0.5rem;
    }

    .card-wrapper {
      width: 200px;
    }
  }

  @media (max-width: 768px) {
    .card-display {
      padding: 1rem;
      overflow: hidden;
    }

    .card-wrapper {
      width: 190px;
      transform: none;
    }

    .card-image {
      transform: rotate(0deg);
    }
  }

  @media (max-width: 480px) {
    .card-wrapper {
      width: 150px;
    }
  }
</style>
