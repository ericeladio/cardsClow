---
interface Props {
  footerText?: string;
}

const {
  footerText = "© 2026 Tarot Readings. All rights reserved.",
} = Astro.props;
---

<footer class="footer">
  <!-- Golden curve decoration -->
  <div class="footer-curve">
    <svg viewBox="0 0 400 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-50 40 Q100 0 200 40 Q300 80 450 40" stroke="var(--color-gold)" stroke-width="1.5" fill="none" opacity="0.25"/>
    </svg>
  </div>
  
  <div class="footer-content">
    <p class="footer-text">{footerText}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 3rem;
    text-align: center;
    margin-top: auto;
    position: relative;
    overflow: hidden;
  }

  .footer-curve {
    position: absolute;
    top: -40px;
    left: 0;
    right: 0;
    width: 100%;
    pointer-events: none;
  }

  .footer-curve svg {
    width: 100%;
    height: 80px;
  }

  .footer-content {
    position: relative;
    z-index: 1;
  }

  .footer-text {
    font-size: 0.75rem;
    color: var(--color-text);
    opacity: 0.4;
    font-family: var(--font-sans);
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 1.5rem;
    }
  }
</style>
