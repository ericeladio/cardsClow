---
import CardOfTheDayIsland from './islands/CardOfTheDayIsland';
import type { Locale } from '../data/clowCards';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
---

<section class="card-of-the-day" data-locale={locale}>
  <!-- Golden glow backdrop -->
  <div class="magic-glow"></div>
  
  <!-- Golden magical particles -->
  <div class="magic-particles">
    <span class="particle p1"></span>
    <span class="particle p2"></span>
    <span class="particle p3"></span>
    <span class="particle p4"></span>
    <span class="particle p5"></span>
    <span class="particle p6"></span>
    <span class="particle p7"></span>
    <span class="particle p8"></span>
    <span class="particle p9"></span>
    <span class="particle p10"></span>
  </div>

  <div class="cotd-content">
    <CardOfTheDayIsland locale={locale} mode="text" client:load />

    <div class="magic-hand">
      <img src="/assets/magic_hand.png" alt="Mano mágica dorada invocando energía de las Cartas Clow" width="190" height="190" loading="lazy" decoding="async" />
    </div>
  </div>

  <!-- Small decorative stars -->
  <svg class="card-star-left" viewBox="0 0 16 16" fill="none">
    <path d="M8 0L9.5 6L16 5L10.5 8L16 11L9.5 10L8 16L6.5 10L0 11L5.5 8L0 5L6.5 6L8 0Z" fill="var(--color-gold)" opacity="0.6"/>
  </svg>
  <svg class="card-star-right" viewBox="0 0 16 16" fill="none">
    <path d="M8 0L9.5 6L16 5L10.5 8L16 11L9.5 10L8 16L6.5 10L0 11L5.5 8L0 5L6.5 6L8 0Z" fill="var(--color-gold)" opacity="0.6"/>
  </svg>
</section>

<style>
  .card-of-the-day {
    padding: 1.2rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    animation: fadeInRight 0.8s ease-out 0.2s both;
    overflow: visible;
    height: 100%;
    position: relative;
  }

  /* Golden glow backdrop */
  .magic-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 340px;
    height: 420px;
    background: radial-gradient(
      ellipse at center,
      rgba(212, 168, 83, 0.18) 0%,
      rgba(212, 168, 83, 0.10) 30%,
      rgba(212, 168, 83, 0.05) 50%,
      rgba(180, 140, 40, 0.02) 70%,
      transparent 100%
    );
    border-radius: 50%;
    z-index: 0;
    animation: glowPulse 4s ease-in-out infinite;
  }

  /* Golden magical particles */
  .magic-particles {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--color-gold);
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat 6s ease-in-out infinite;
  }

  .p1 { top: 15%; left: 20%; animation-delay: 0s; animation-duration: 5s; }
  .p2 { top: 25%; right: 25%; animation-delay: 0.8s; animation-duration: 7s; }
  .p3 { top: 40%; left: 12%; animation-delay: 1.5s; animation-duration: 6s; }
  .p4 { top: 60%; right: 15%; animation-delay: 2.2s; animation-duration: 5.5s; }
  .p5 { top: 75%; left: 30%; animation-delay: 3s; animation-duration: 6.5s; }
  .p6 { top: 20%; left: 50%; animation-delay: 0.5s; animation-duration: 7.5s; width: 2px; height: 2px; }
  .p7 { top: 55%; left: 8%; animation-delay: 1.8s; animation-duration: 5.8s; width: 2px; height: 2px; }
  .p8 { top: 80%; right: 30%; animation-delay: 2.8s; animation-duration: 6.2s; width: 4px; height: 4px; }
  .p9 { top: 35%; right: 10%; animation-delay: 3.5s; animation-duration: 7.2s; width: 2px; height: 2px; }
  .p10 { top: 10%; right: 40%; animation-delay: 4s; animation-duration: 5.3s; }

  .cotd-content {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .card-star-left,
  .card-star-right {
    position: absolute;
    width: 10px;
    height: 10px;
    z-index: 2;
    animation: twinkle 3s ease-in-out infinite;
  }

  .card-star-left {
    bottom: 35%;
    left: 10%;
    animation-delay: 0.5s;
  }

  .card-star-right {
    bottom: 45%;
    right: 10%;
    animation-delay: 1s;
  }

  :global(.cotd-header) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.cotd-star) {
    width: 16px;
    height: 16px;
    animation: twinkle 3s ease-in-out infinite;
  }

  :global(.date-display) {
    display: flex;
    flex-direction: column;
  }

  :global(.date-display .date-day) {
    font-size: 2rem;
    font-weight: 300;
    color: var(--color-text);
    line-height: 1;
    font-family: var(--font-serif);
  }

  :global(.date-display .date-month) {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: var(--font-sans);
    font-weight: 400;
  }

  :global(.cotd-title) {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    /* color: var(--color-text); */
    font-weight: 600;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(212, 168, 83, 0.3);
    margin: 0;
  }

  .magic-hand {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 0.3rem;
  }

  .magic-hand img {
    width: 190px;
    max-height: 190px;
    object-fit: contain;
    opacity: 0.6;
    filter: brightness(0.9) contrast(1.1);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .magic-hand img:hover {
    opacity: 0.8;
    transform: scale(1.05);
  }

  :global(.card-details) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  :global(.card-name) {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-gold);
    font-weight: 600;
    letter-spacing: 0.03em;
    margin: 0;
  }

  :global(.card-meaning) {
    font-size: 0.75rem;
    color: var(--color-text);
    opacity: 0.85;
    line-height: 1.6;
    font-family: var(--font-sans);
    font-weight: 300;
    margin: 0;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  @keyframes particleFloat {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    15% {
      opacity: 0.8;
      transform: translateY(-10px) scale(1);
    }
    50% {
      opacity: 0.4;
      transform: translateY(-25px) scale(0.8);
    }
    85% {
      opacity: 0.7;
      transform: translateY(-15px) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
  }

  @media (max-width: 1200px) {
    .card-of-the-day {
      padding: 1rem 0.8rem;
    }

    .cotd-content {
      gap: 0.8rem;
    }

    :global(.date-display .date-day) {
      font-size: 1.8rem;
    }

    :global(.cotd-title) {
      font-size: 1.1rem;
    }

    .magic-hand img {
      width: 160px;
      max-height: 160px;
    }

    .magic-glow {
      width: 280px;
      height: 360px;
    }
  }

  @media (max-width: 768px) {
    .card-of-the-day {
      padding: 0.8rem 0.6rem;
      overflow: hidden;
    }

    :global(.date-display .date-day) {
      font-size: 1.6rem;
    }

    :global(.cotd-title) {
      font-size: 1rem;
    }

    .magic-hand img {
      width: 140px;
      max-height: 140px;
    }

    .magic-glow {
      width: 300px;
      height: 380px;
    }

    .card-star-left,
    .card-star-right {
      display: none;
    }

    .magic-particles .particle {
      animation-duration: 8s;
    }
  }

  @media (max-width: 480px) {
    .magic-glow {
      width: 240px;
      height: 300px;
    }

    .magic-hand img {
      width: 120px;
      max-height: 120px;
    }

    :global(.cotd-title) {
      font-size: 0.9rem;
    }

    :global(.date-display .date-day) {
      font-size: 1.4rem;
    }

    :global(.card-name) {
      font-size: 1.1rem;
    }

    :global(.card-meaning) {
      font-size: 0.7rem;
    }
  }
</style>
